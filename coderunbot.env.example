# Example environment for CodeRunBot (systemd --user)
# Place this at: ~/.config/environment.d/coderunbot.env
# or copy keys into a local .env file outside version control.

# ---- Discord tokens ----
CODERUNBOT_TOKEN=
GAATO_BOT_TOKEN=

# MoonBit port token (separate token recommended during parallel deployment)
CODERUNBOT_MBT_TOKEN=

# Optional: sync application commands to one guild instead of globally
# GUILD_ID=

# Optional: remote text-state endpoint for opt-out users (GET/PUT)
OPT_OUT_PAR_URL=

# Optional local fallback; defaults to ./data/opt-out-users.txt
# OPT_OUT_FILE=./data/opt-out-users.txt

# Container default is ./texworker/worker.js relative to /app/mbt
# TEX_WORKER_PATH=./texworker/worker.js

# ---- Optional features ----
OPENAI_API_KEY=
WOLFRAM_APPID=
# GOOGLE_API_KEY=  # mentioned in README; may be unused depending on enabled cogs

# ---- TeX renderer endpoint ----
# TEX_BASE_URL defaults to http://127.0.0.1:8080 when unset
TEX_BASE_URL=http://127.0.0.1:8080
