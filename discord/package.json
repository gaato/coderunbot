{
  "name": "coderunbot-discord",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src && dependency-cruiser --config .dependency-cruiser.cjs --include-only '^src' src && madge --circular --extensions ts src",
    "format": "biome format --write src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1089.0",
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "i18next": "^26.3.6",
    "iso-639-1": "^3.1.6",
    "openai": "^6.48.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^18.1.0",
    "madge": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
